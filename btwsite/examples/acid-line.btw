#! btw 1
#! name: acid-line
#! license: CC0-1.0
#! visibility: public
# acid-line: a squelchy bass with an accent (!) and a slide (^), under a filter that opens over 16 bars.
# An accent is a harder hit; a slide holds the note into the next step. The line repeats every bar.
tempo 132
key am
let acid = a1! ~ a1 ~ c2^ ~ a1 e2! ~ a1 ~ ~ g1 ~ a1^ ~
deck A: kick x ~ ~ ~ x ~ ~ ~ x ~ ~ ~ x ~ ~ ~ | hihat ~ ~ x ~ ~ ~ x ~ ~ ~ x ~ ~ ~ x ~ vel=55..85
deck B: bass acid inst=fm-bass
master: filter lp 300 -> 3200 over 16 bars
master: resonance 0.2 -> 0.7 over 16 bars
end at bar 16
