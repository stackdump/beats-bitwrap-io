#! btw 1
#! name: matrix-130
#! license: CC0-1.0
#! visibility: public
tempo 130
key d:phrygian
let k_a = x ~ ~ ~ ~ ~ x ~ ~ ~ ~ ~ ~ ~ ~ ~
let k_b = x ~ ~ ~ ~ ~ x ~ ~ ~ x ~ ~ ~ ~ x
let snares = ~ ~ ~ ~ x! ~ ~ x ~ x ~ ~ x! ~ ~ x
let hats = x*16
let riff_a = d2 ~ d2 ~ d2 ~ d#2 ~ d2 ~ d2 ~ f2 ~ d#2 d2
let riff_b = d2 ~ ~ d2 ~ ~ d#2 ~ a2 ~ ~ g2 ~ d#2 d2 ~
let p_a = a4 ~ ~ ~ ~ ~ ~ ~ a#4 ~ ~ ~ a4 ~ ~ ~
let p_b = ~ ~ ~ ~ g4 ~ ~ ~ f4 ~ ~ ~ ~ ~ ~ ~
let p_c = d5 ~ ~ ~ ~ ~ ~ ~ c5 ~ ~ ~ a#4 ~ ~ ~
let p_d = a4 ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~
let p_up = transpose([<p_a p_b p_c p_d>], 1)
let toms = d3 ~ d3 d3 ~ a2 ~ d3 ~ d3 a2 ~ d3 ~ a2 a2
let q2 = x ~ x ~
let q4 = x x x x
let eighths = x*8
let s16 = x*16
def breaks(bars) {
  deck A: kick <k_a k_a k_a k_b> kit=drums-breakbeat | snare snares vel=50..72 | hihat humanize([hats], 3, 14) vel=38..100
  master: filter lp 3000 -> 14000 over $bars bars
}
def stabs(chord, alt) {
  deck B: harmony chord($chord, 3) ~ ~ chord($chord, 3) ~ ~ chord($chord, 3) ~ ~ ~ chord($alt, 3) ~ ~ ~ ~ ~ inst=strings len=1 vel=88..112
}
def rain(seed) {
  deck B: arp degrade([<arp(dm7, updown, 16) arp(dm7, updown, 16) arp(d#maj7, updown, 16) arp(dm7, up, 16)>], 0.3, $seed) inst=bright-pluck oct=5 vel=36..78
}
section intro 8 bars {
  rain(7)
  deck B: melody <p_a p_b p_c p_d> inst=piano len=8 vel=60..80
  master: filter lp 500 -> 9000 over 8 bars
  master: reverb 0.3
}
section breakin 8 bars {
  breaks(8)
  rain(7)
  deck B: melody <p_a p_b p_c p_d> inst=piano len=8 vel=60..80
}
section drive 16 bars {
  master: filter off
  master: reverb 0.15
  breaks(16)
  deck A: bass <riff_a riff_a riff_a riff_b> inst=distorted-lead vel=96..115
  stabs(dm, d#)
  rain(11)
}
section breakdown 8 bars {
  master: filter lp 9000 -> 2500 over 8 bars
  master: reverb 0.5
  deck B: melody <p_a p_b p_c p_d> inst=piano len=8 vel=70..92 | harmony <chord(dm, 3) chord(d#, 3) chord(a#, 3) chord(a, 3)> inst=dark-pad len=16 | arp degrade([arp(dm7, updown, 16)], 0.6, 5) inst=bright-pluck oct=5 vel=30..50
  deck A: hihat x ~ ~ ~ vel=30..45
}
section riser 8 bars {
  master: filter hp 100 -> 4500 over 8 bars
  master: reverb 0.2 -> 0.6 over 8 bars
  deck A: snare <q2 q2 q4 q4 eighths eighths s16 s16> vel=60..100
  deck A: level 0.85 -> 1 over 8 bars
  deck B: harmony <chord(dm, 3) chord(dm, 3) chord(d#, 3) chord(d#, 3)>*2 inst=strings len=16 vel=55..90
  rain(3)
}
section climax 16 bars {
  master: filter off
  master: reverb 0.15
  wheel play
  wheel level db=-6
  wheel sync deck=A ratio=2
  breaks(2)
  deck A: bass <riff_a riff_a riff_b riff_b> inst=distorted-lead vel=100..120 | melody toms inst=subdrop oct=3 vel=85..120 | clap e(5, 16) vel=60..90
  stabs(dm, d#)
  deck B: melody <p_a p_b p_c p_d> inst=piano len=6 vel=80..100
  rain(19)
  evolve every 4 bars {
    arp: rotate <0 2 5 3> | transpose <0 0 3 -2>
    hihat: thin 0.1 seed=3
    stop when gen == 3
  }
}
section lift 8 bars {
  master: filter off
  breaks(1)
  deck A: bass transpose([<riff_a riff_a riff_a riff_b>], 1) inst=distorted-lead vel=104..124 | melody transpose([toms], 1) inst=subdrop oct=3 vel=90..124 | clap e(7, 16) vel=65..100
  stabs(d#m, e)
  deck B: melody p_up inst=piano len=6 vel=85..105 | arp degrade([<arp(d#m7, updown, 16) arp(d#m7, updown, 16) arp(emaj7, updown, 16) arp(d#m7, up, 16)>], 0.25, 23) inst=bright-pluck oct=5 vel=40..85
  master: reverb 0.15 -> 0.4 over 8 bars
}
section outro 8 bars {
  wheel pause
  master: filter lp 8000 -> 1500 over 8 bars
  master: reverb 0.45
  deck B: melody <p_a p_b p_c p_d ~ ~ ~ ~> inst=piano len=8 vel=55..75
}
arrange intro breakin drive breakdown riser climax lift outro
end after outro
