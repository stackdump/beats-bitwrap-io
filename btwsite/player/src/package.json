{
  "name": "@beatscript/player",
  "version": "0.1.0",
  "private": true,
  "description": "<beatscript-track>: a BeatScript program and its player in one self-contained element. The engine (WebAssembly, inlined), its kits, voices and sing tables are bundled; nothing is fetched from beatscript.app. Plays from a click.",
  "type": "module",
  "main": "./beatscript-track.umd.js",
  "module": "./beatscript-track.js",
  "browser": "./beatscript-track.js",
  "exports": {
    ".": { "import": "./beatscript-track.js", "default": "./beatscript-track.umd.js" },
    "./umd": "./beatscript-track.umd.js",
    "./package.json": "./package.json"
  },
  "jsdelivr": "./beatscript-track.js",
  "unpkg": "./beatscript-track.umd.js",
  "files": ["beatscript-track.js", "beatscript-track.umd.js", "js/", "wasm/", "test/", "README.md", "hashes.json"],
  "sideEffects": true,
  "keywords": ["beatscript", "music", "live-coding", "web-component", "webassembly", "audioworklet"],
  "homepage": "https://beatscript.app/docs/embed",
  "license": "UNLICENSED"
}
