{
  "@context": {
    "bw": "https://ontology.bitwrap.io/ns#",
    "djrust": "https://beats.bitwrap.io/ns/djrust#",
    "dct": "http://purl.org/dc/terms/",
    "author": "dct:creator",
    "bars": "djrust:bars",
    "cid": "djrust:cid",
    "credit": {"@id": "djrust:credit", "@container": "@set"},
    "euclid": {"@id": "djrust:euclid", "@container": "@set"},
    "forkedFrom": {"@id": "djrust:forkedFrom", "@type": "@id"},
    "genre": {"@id": "djrust:genre", "@type": "@id"},
    "key": "djrust:key",
    "license": {"@id": "dct:license", "@type": "@id"},
    "licenseId": "djrust:licenseId",
    "name": "dct:title",
    "sameShapeAs": {"@id": "djrust:sameShapeAs", "@type": "@id", "@container": "@set"},
    "sections": {"@id": "djrust:section", "@container": "@list"},
    "start": "djrust:start",
    "tag": {"@id": "djrust:tag", "@type": "@id", "@container": "@set"},
    "tempo": "djrust:tempo",
    "uses": "djrust:uses",
    "visibility": "djrust:visibility"
  }
}
