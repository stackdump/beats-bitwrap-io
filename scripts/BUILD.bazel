load("//tools:nodejs_test.bzl", "nodejs_test")

# Go<->JS cohesion-v2 parity: runs the browser-side buildTrackTheme()/compose()
# against the same pinned fixture the Go test asserts on. Pure ES modules — the
# generator tree is staged as runfiles; the .mjs resolves "../public/lib/..."
# relative to its own location, so no cwd assumptions.
nodejs_test(
    name = "cohesion_parity_test",
    data = [
        "test-cohesion-parity.mjs",
        "//:js_generator_srcs",
    ],
    entry_point = "test-cohesion-parity.mjs",
    visibility = ["//visibility:public"],
)

# Wave engine: determinism, P-invariants, ring spectrum, executor parity.
# The test spawns wave-render.mjs and a --expose-gc child with the same
# hermetic node (process.execPath), so both are staged here.
nodejs_test(
    name = "wave_engine_test",
    data = [
        "test-wave-engine.mjs",
        "wave-render.mjs",
        "//:js_generator_srcs",
        "//:js_wave_engine_srcs",
    ],
    entry_point = "test-wave-engine.mjs",
    visibility = ["//visibility:public"],
)
